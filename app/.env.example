# =====================================================
# CineLog — client configuration
# =====================================================
# Everything here is prefixed EXPO_PUBLIC_, which means Expo inlines it into the
# JavaScript bundle. Never put a secret in this file.

# Base URL of the CineLog media API. The API holds the TMDB key server-side, so
# the app never ships one.
EXPO_PUBLIC_API_BASE=https://your-cinelog-api.onrender.com

# Optional comma-separated fallbacks, tried in order when the primary is down.
EXPO_PUBLIC_API_BASES=

# Optional: talk to TMDB directly instead of through the API. Only useful for
# standalone builds shipped without a backend. A key added here IS visible in
# the bundle, so prefer the API for anything public-facing.
# Enabling this also unlocks people search, which the API does not expose.
# Get a key at https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=

# =====================================================
# Accounts (Firebase) — optional
# =====================================================
# Without these, CineLog keeps the account on the device and the library stays
# local. Add a Firebase web app to enable synced accounts and password resets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth client IDs (Firebase Auth > Sign-in method > Google)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
