{
  "name": "cinelog-app",
  "main": "expo-router/entry",
  "version": "1.0.13",
  "scripts": {
    "postinstall": "patch-package || true",
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "web:export": "NODE_ENV=production npx expo export --platform web --output-dir dist",
    "start": "npx expo start --port 18081",
    "start:lan": "npx expo start --lan --port 18081 --clear",
    "start:tunnel": "npx expo start --tunnel --port 18081 --clear",
    "start:web": "npx expo start --web --port 18081",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "typecheck": "npx tsc --noEmit",
    "ota:production": "NODE_ENV=production npx eas-cli update --branch production --message \"cinelog-ota-production\"",
    "ota:preview": "NODE_ENV=production npx eas-cli update --branch preview --message \"cinelog-ota-preview\"",
    "release:apk": "cd ../android && NODE_ENV=production ./gradlew assembleRelease -x externalNativeBuildDebug",
    "release:ci": "cd ../android && NODE_ENV=production ./gradlew clean assembleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a --no-daemon --stacktrace",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.83.0",
    "expo": "~54.0.27",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.11",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-modules-core": "^3.0.29",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.17",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "firebase": "^12.11.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
